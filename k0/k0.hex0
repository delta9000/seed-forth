0F 82 1A 01 00 00                         ; 0x27B  jc ebadf  (rel32 = 0x39B - 0x281; ebadf = 0x10039B)
89 D1                                     ; 0x281  mov ecx, edx
51                                        ; 0x283  push rcx
FF C8                                     ; 0x284  dec eax
75 0C                                     ; 0x286  jnz .file  (rel8 = 0x294 - 0x288)
66 BA F8 03                               ; 0x288  mov dx, 0x3F8
E3 04                                     ; 0x28C  jrcxz .wdone  (rel8 = 0x292 - 0x28E)  ; a byte loop, not rep outsb: QEMU 8.2's
;;   .wout @ 0x28E
AC                                        ; 0x28E  lodsb  ; TCG aborts on K0's rep outsb
EE                                        ; 0x28F  out dx, al
E2 FC                                     ; 0x290  loop .wout  (rel8 = 0x28E - 0x292)
;;   .wdone @ 0x292

58                                        ; 0x292  pop rax
C3                                        ; 0x293  ret
;;   .file @ 0x294
FF C0                                     ; 0x294  inc eax
8B 53 04                                  ; 0x296  mov edx, [rbx + 4]  ; pos
01 CA                                     ; 0x299  add edx, ecx  ; end
3B 50 10                                  ; 0x29B  cmp edx, [rax + E_CAP]  (E_CAP = 0x10)
76 19                                     ; 0x29E  jbe .fits  (rel8 = 0x2B9 - 0x2A0)
56                                        ; 0x2A0  push rsi  ; grow to twice the new end;
8D 0C 12                                  ; 0x2A1  lea ecx, [rdx + rdx]  ; fresh heap is zero, so bytes
89 48 10                                  ; 0x2A4  mov [rax + E_CAP], ecx  (E_CAP = 0x10)  ; past size always read as zero
