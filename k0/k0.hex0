FF C0                                     ; 0x290  inc eax
8B 53 04                                  ; 0x292  mov edx, [rbx + 4]  ; pos
01 CA                                     ; 0x295  add edx, ecx  ; end
3B 50 10                                  ; 0x297  cmp edx, [rax + E_CAP]  (E_CAP = 0x10)
76 19                                     ; 0x29A  jbe .fits  (rel8 = 0x2B5 - 0x29C)
56                                        ; 0x29C  push rsi  ; grow to twice the new end;
8D 0C 12                                  ; 0x29D  lea ecx, [rdx + rdx]  ; fresh heap is zero, so bytes
89 48 10                                  ; 0x2A0  mov [rax + E_CAP], ecx  (E_CAP = 0x10)  ; past size always read as zero
8B 7D 98                                  ; 0x2A3  mov edi, [rbp + G_HEAP]  (G_HEAP = -0x68)
01 4D 98                                  ; 0x2A6  add [rbp + G_HEAP], ecx  (G_HEAP = -0x68)
8B 70 08                                  ; 0x2A9  mov esi, [rax + E_DATA]  (E_DATA = 0x8)
89 78 08                                  ; 0x2AC  mov [rax + E_DATA], edi  (E_DATA = 0x8)
8B 48 0C                                  ; 0x2AF  mov ecx, [rax + E_SIZE]  (E_SIZE = 0xC)
F3 A4                                     ; 0x2B2  rep movsb
