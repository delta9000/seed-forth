8B 48 0C                                  ; 0x252  mov ecx, [rax + E_SIZE]  (E_SIZE = 0xC)
2B 4B 04                                  ; 0x255  sub ecx, [rbx + 4]
0F 86 36 01 00 00                         ; 0x258  jbe ok  (rel32 = 0x394 - 0x25E; ok = 0x100394)
48 39 D1                                  ; 0x25E  cmp rcx, rdx
76 02                                     ; 0x261  jbe .n  (rel8 = 0x265 - 0x263)
