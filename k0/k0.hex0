0F 82 16 01 00 00                         ; 0x27B  jc ebadf  (rel32 = 0x397 - 0x281; ebadf = 0x100397)
89 D1                                     ; 0x281  mov ecx, edx
51                                        ; 0x283  push rcx
FF C8                                     ; 0x284  dec eax
75 08                                     ; 0x286  jnz .file  (rel8 = 0x290 - 0x288)
66 BA F8 03                               ; 0x288  mov dx, 0x3F8
F3 6E                                     ; 0x28C  rep outsb
58                                        ; 0x28E  pop rax
C3                                        ; 0x28F  ret
