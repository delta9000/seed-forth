;; k0.hex0 — K0, a single-task bootstrap kernel for seed-forth's amd64 route
;;
;; License: MIT (see /LICENSE)
;;
;; K0 boots under QEMU as a multiboot kernel and runs the seed-only
;; amd64 route (seed -> pnut -> TinyCC 0.9.27) by providing the 17 Linux
;; syscalls it uses, over a RAM file system.  k0/README.md describes the
;; design, the boot image and every assumption about the chain.
;;
;; How to read this file: every line is one instruction or one data
;; field; the text after ';' is a comment (hex0 ignores it).  Each
;; comment starts with the file offset; the image loads at 0x100000, so
;; offset 0xNNN is address 0x100NNN.  Relative branches show their
;; arithmetic, (rel8 = target - next instruction); operands that name a
;; label or constant show its value.  The file is 1309 bytes, loaded
;; at 0x100000 to 0x10051D.
;;
;; Build:  hex0-seed k0/k0.hex0 k0.bin  (stage0-posix's 229-byte hex0)
;; k0/k0.asm is the same program as NASM source; k0/check.sh proves
;; nasm(k0.asm) and hex0(k0.hex0) are byte-identical.
;;
;; Fixed addresses (identity-mapped):
;;   0x00100000  K0 (this file)
;;   0x00400000  user images (0x400000.. and 0x40000000..)
;;   0x30000000  PB, the canonical-path buffer; 0x30010000 KB, argv block
;;   0x3FFF0000  SP0, a new program's initial rsp; argv strings above it
;;   0x50000000  FSIMG, the boot image from mkfs.py; rbp = 0x50000080
;;   0x80000000  anonymous mmap and fork snapshots, growing up

;; K0: a single-task bootstrap kernel for the seed-forth amd64 route.
;;
;; Multiboot (a.out kludge) -> long mode, the first 4 GiB identity-mapped
;; with 1 GiB pages, everything in ring 0, interrupts off.  Programs enter
;; through SYSCALL and return through JMP, so there is no TSS, no IDT and
;; no user segment.
;;
;; K0 boots from a memory image that mkfs.py writes and QEMU's loader
;; places at FSIMG: kernel state, page tables, init's argv, and the file
;; table with every file's contents.  Names are canonical: no leading '/'.
;;
;; fork runs the child to completion: the parent's registers, process
;; state, image and stack are saved, then restored when the child exits.
;; Every fork in the chain is fork -> redirect -> execve with the parent
;; waiting at once, so nothing else is needed.
;;
;; Every address K0 handles is below 4 GiB, so it works in 32-bit
;; registers wherever a value is its own.

;;   SP0 = 0x3FFF0000                      ; initial rsp; the argv block sits above it
;;   STOP = 0x40000000                     ; top of the region saved as "stack"
;;   PB = 0x30000000                       ; canonical path buffer
;;   KB = 0x30010000                       ; argv block under construction
;;   FSIMG = 0x50000000                    ; the boot image (see mkfs.py)
;;   BASE = FSIMG + 0x80 = 0x50000080      ; rbp: kernel state
;;   PML4 = FSIMG + 0x1000 = 0x50001000
;;   INIT = FSIMG + 0x3000 = 0x50003000    ; init's argv; the path follows it
;;   ENTS = FSIMG + 0x4000 = 0x50004000    ; file table, 24-byte entries

;; file entry, 6 dwords
;;   E_NAME = 0 = 0x0
;;   E_NLEN = 4 = 0x4
;;   E_DATA = 8 = 0x8
;;   E_SIZE = 12 = 0xC
;;   E_CAP = 16 = 0x10
;;   E_TYPE = 20 = 0x14                    ; byte: 0 deleted, 1 file, 2 directory
;;   CONSOLE = 1 = 0x1                     ; fd entry value meaning the serial port

;; rbp-relative kernel state.  [U, P_END) is what fork saves.
;;   G_FP = -128 = -0x80                   ; innermost fork snapshot, 0 at top level
;;   G_PID = -120 = -0x78
;;   G_END = -112 = -0x70                  ; end of the file table
;;   G_HEAP = -104 = -0x68
;;   G_BUMP = -96 = -0x60
;;   G_PBLEN = -88 = -0x58
;;   U = -80 = -0x50                       ; user registers, in push order
;;   U_RFL = -48 = -0x30                   ; (r11)
;;   U_RIP = 24 = 0x18                     ; (rcx)
;;   U_RAX = 32 = 0x20
;;   U_RSP = 40 = 0x28
;;   P_CWDLEN = 48 = 0x30
;;   P_LO = 56 = 0x38                      ; loaded image [lo, hi)
;;   P_HI = 64 = 0x40
;;   P_LPID = 72 = 0x48                    ; last child: pid and wait status
;;   P_LST = 80 = 0x50
;;   P_FDS = 88 = 0x58                     ; 64 x {entry, pos}
;;   P_CWD = 600 = 0x258
;;   P_END = 1112 = 0x458

;; ----- hdr @ 0x000 -----
02 B0 AD 1B                               ; 0x000  dd 0x1BADB002
00 00 01 00                               ; 0x004  dd 0x00010000
FE 4F 51 E4                               ; 0x008  dd -(0x1BADB002 + 0x00010000)
00 00 10 00                               ; 0x00C  dd hdr
00 00 10 00                               ; 0x010  dd hdr
1D 05 10 00                               ; 0x014  dd file_end
1D 05 10 00                               ; 0x018  dd file_end
20 00 10 00                               ; 0x01C  dd start32

;; ----- start32 @ 0x020 -----

B8 00 10 00 50                            ; 0x020  mov eax, PML4  (PML4 = 0x50001000)
0F 22 D8                                  ; 0x025  mov cr3, eax
B8 20 06 00 00                            ; 0x028  mov eax, 0x620  ; PAE | OSFXSR | OSXMMEXCPT
0F 22 E0                                  ; 0x02D  mov cr4, eax
B9 80 00 00 C0                            ; 0x030  mov ecx, 0xC0000080  ; EFER: LME | SCE
0F 32                                     ; 0x035  rdmsr
0D 01 01 00 00                            ; 0x037  or eax, 0x101
0F 30                                     ; 0x03C  wrmsr
0F 20 C0                                  ; 0x03E  mov eax, cr0
0D 02 00 00 80                            ; 0x041  or eax, 0x80000002  ; PG | MP
0F 22 C0                                  ; 0x046  mov cr0, eax
0F 01 15 57 00 10 00                      ; 0x049  lgdt [gdt]  (gdt = 0x100057)
EA 67 00 10 00 08 00                      ; 0x050  jmp 8:start64  (start64 = 0x100067)

;; ----- gdt @ 0x057 -----
0F 00                                     ; 0x057  dw 15  ; the null descriptor holds the GDTR
57 00 10 00                               ; 0x059  dd gdt  (gdt = 0x100057)
00 00                                     ; 0x05D  dw 0
00 00 00 00 00 9A 20 00                   ; 0x05F  dq 0x00209A0000000000  ; 64-bit code

;; ----- start64 @ 0x067 -----

BD 80 00 00 50                            ; 0x067  mov ebp, BASE  (BASE = 0x50000080)
8D 65 80                                  ; 0x06C  lea esp, [rbp + G_FP]  (G_FP = -0x80)  ; kernel stack: below the image
B9 81 00 00 C0                            ; 0x06F  mov ecx, 0xC0000081  ; STAR: syscall CS 8, SS 16
31 C0                                     ; 0x074  xor eax, eax
BA 08 00 10 00                            ; 0x076  mov edx, 0x00100008
0F 30                                     ; 0x07B  wrmsr
FF C1                                     ; 0x07D  inc ecx  ; LSTAR
B8 98 00 10 00                            ; 0x07F  mov eax, syscall_entry  (syscall_entry = 0x100098)
99                                        ; 0x084  cdq
0F 30                                     ; 0x085  wrmsr
BF 10 30 00 50                            ; 0x087  mov edi, INIT + 16  (INIT = 0x50003000)
BE 00 30 00 50                            ; 0x08C  mov esi, INIT  (INIT = 0x50003000)
E8 C6 03 00 00                            ; 0x091  call sys_execve  (rel32 = 0x45C - 0x096; sys_execve = 0x10045C)
EB 4E                                     ; 0x096  jmp ret_user  (rel8 = 0x0E6 - 0x098; ret_user = 0x1000E6)

;; ---- entry and exit -------------------------------------------------------

;; ----- syscall_entry @ 0x098 -----

48 89 24 25 A8 00 00 50                   ; 0x098  mov [abs BASE + U_RSP], rsp  (BASE = 0x50000080; U_RSP = 0x28)
BC A8 00 00 50                            ; 0x0A0  mov esp, BASE + U_RSP  (BASE = 0x50000080; U_RSP = 0x28)
50                                        ; 0x0A5  push rax
51                                        ; 0x0A6  push rcx
52                                        ; 0x0A7  push rdx
53                                        ; 0x0A8  push rbx
55                                        ; 0x0A9  push rbp
56                                        ; 0x0AA  push rsi
57                                        ; 0x0AB  push rdi
41 50                                     ; 0x0AC  push r8
41 51                                     ; 0x0AE  push r9
41 52                                     ; 0x0B0  push r10
41 53                                     ; 0x0B2  push r11
41 54                                     ; 0x0B4  push r12
41 55                                     ; 0x0B6  push r13
41 56                                     ; 0x0B8  push r14
41 57                                     ; 0x0BA  push r15
BD 80 00 00 50                            ; 0x0BC  mov ebp, BASE  (BASE = 0x50000080)
8D 65 80                                  ; 0x0C1  lea esp, [rbp + G_FP]  (G_FP = -0x80)
BB 0A 01 10 00                            ; 0x0C4  mov ebx, sctab  (sctab = 0x10010A)
;;   .find @ 0x0C9
38 03                                     ; 0x0C9  cmp [rbx], al
74 0D                                     ; 0x0CB  je .hit  (rel8 = 0x0DA - 0x0CD)
83 C3 03                                  ; 0x0CD  add ebx, 3
80 3B FF                                  ; 0x0D0  cmp byte [rbx], 0xFF
75 F4                                     ; 0x0D3  jne .find  (rel8 = 0x0C9 - 0x0D5)
6A DA                                     ; 0x0D5  push -38  ; ENOSYS
58                                        ; 0x0D7  pop rax
EB 0C                                     ; 0x0D8  jmp ret_user  (rel8 = 0x0E6 - 0x0DA; ret_user = 0x1000E6)
;;   .hit @ 0x0DA
0F B7 5B 01                               ; 0x0DA  movzx ebx, word [rbx + 1]
81 C3 41 01 10 00                         ; 0x0DE  add ebx, handlers  (handlers = 0x100141)
FF D3                                     ; 0x0E4  call rbx

;; ----- ret_user @ 0x0E6 -----

48 89 45 20                               ; 0x0E6  mov [rbp + U_RAX], rax  (U_RAX = 0x20)
8D 65 B0                                  ; 0x0EA  lea esp, [rbp + U]  (U = -0x50)
41 5F                                     ; 0x0ED  pop r15
41 5E                                     ; 0x0EF  pop r14
41 5D                                     ; 0x0F1  pop r13
41 5C                                     ; 0x0F3  pop r12
41 5B                                     ; 0x0F5  pop r11
41 5A                                     ; 0x0F7  pop r10
41 59                                     ; 0x0F9  pop r9
41 58                                     ; 0x0FB  pop r8
5F                                        ; 0x0FD  pop rdi
5E                                        ; 0x0FE  pop rsi
5D                                        ; 0x0FF  pop rbp
5B                                        ; 0x100  pop rbx
5A                                        ; 0x101  pop rdx
59                                        ; 0x102  pop rcx
58                                        ; 0x103  pop rax
41 53                                     ; 0x104  push r11
9D                                        ; 0x106  popfq
5C                                        ; 0x107  pop rsp
FF E1                                     ; 0x108  jmp rcx

;; ----- sctab @ 0x10A -----
00 06 01                                  ; 0x10A  syscall 0 -> sys_read (handlers + 0x106)
01 35 01                                  ; 0x10D  syscall 1 -> sys_write (handlers + 0x135)
02 A5 00                                  ; 0x110  syscall 2 -> sys_open (handlers + 0xA5)
03 F3 00                                  ; 0x113  syscall 3 -> sys_close (handlers + 0xF3)
06 C0 01                                  ; 0x116  syscall 6 -> sys_lstat (handlers + 0x1C0)
08 8B 01                                  ; 0x119  syscall 8 -> sys_lseek (handlers + 0x18B)
09 5E 02                                  ; 0x11C  syscall 9 -> sys_mmap (handlers + 0x25E)
21 AB 01                                  ; 0x11F  syscall 33 -> sys_dup2 (handlers + 0x1AB)
39 77 02                                  ; 0x122  syscall 57 -> sys_fork (handlers + 0x277)
3B 1B 03                                  ; 0x125  syscall 59 -> sys_execve (handlers + 0x31B)
3C A6 02                                  ; 0x128  syscall 60 -> sys_exit (handlers + 0x2A6)
3D 12 03                                  ; 0x12B  syscall 61 -> sys_wait4 (handlers + 0x312)
4F E0 01                                  ; 0x12E  syscall 79 -> sys_getcwd (handlers + 0x1E0)
50 F4 01                                  ; 0x131  syscall 80 -> sys_chdir (handlers + 0x1F4)
52 10 02                                  ; 0x134  syscall 82 -> sys_rename (handlers + 0x210)
53 32 02                                  ; 0x137  syscall 83 -> sys_mkdir (handlers + 0x232)
57 42 02                                  ; 0x13A  syscall 87 -> sys_unlink (handlers + 0x242)
5A 4F 02                                  ; 0x13D  syscall 90 -> ok (handlers + 0x24F)
FF                                        ; 0x140  db 0xFF

;; ---- paths and the file table --------------------------------------------

;; ----- handlers @ 0x141 -----

;; rsi = path -> PB holds its canonical form, [G_PBLEN] its length.
;; The chain's paths never contain "..", an inner "//" or "/./", or a
;; trailing '/'; "./" and repeated '/' occur only as prefixes.

;; ----- canon @ 0x141 -----

BF 00 00 00 30                            ; 0x141  mov edi, PB  (PB = 0x30000000)
80 3E 2F                                  ; 0x146  cmp byte [rsi], '/'
74 1A                                     ; 0x149  je .abs  (rel8 = 0x165 - 0x14B)
56                                        ; 0x14B  push rsi
8D B5 58 02 00 00                         ; 0x14C  lea esi, [rbp + P_CWD]  (P_CWD = 0x258)
8B 4D 30                                  ; 0x152  mov ecx, [rbp + P_CWDLEN]  (P_CWDLEN = 0x30)
F3 A4                                     ; 0x155  rep movsb
5E                                        ; 0x157  pop rsi
81 FF 00 00 00 30                         ; 0x158  cmp edi, PB  (PB = 0x30000000)
74 0C                                     ; 0x15E  je .dots  (rel8 = 0x16C - 0x160)
B0 2F                                     ; 0x160  mov al, '/'
AA                                        ; 0x162  stosb
EB 07                                     ; 0x163  jmp .dots  (rel8 = 0x16C - 0x165)
;;   .abs @ 0x165
FF C6                                     ; 0x165  inc esi  ; ROOT "/" + "/x" gives "//x"
80 3E 2F                                  ; 0x167  cmp byte [rsi], '/'
74 F9                                     ; 0x16A  je .abs  (rel8 = 0x165 - 0x16C)
;;   .dots @ 0x16C
66 81 3E 2E 2F                            ; 0x16C  cmp word [rsi], './'
75 04                                     ; 0x171  jne .copy  (rel8 = 0x177 - 0x173)
66 AD                                     ; 0x173  lodsw
EB F5                                     ; 0x175  jmp .dots  (rel8 = 0x16C - 0x177)
;;   .copy @ 0x177
AC                                        ; 0x177  lodsb
AA                                        ; 0x178  stosb
84 C0                                     ; 0x179  test al, al
75 FA                                     ; 0x17B  jnz .copy  (rel8 = 0x177 - 0x17D)
81 EF 01 00 00 30                         ; 0x17D  sub edi, PB + 1  (PB = 0x30000000)
89 7D A8                                  ; 0x183  mov [rbp + G_PBLEN], edi  (G_PBLEN = -0x58)
C3                                        ; 0x186  ret

;; rdi = path -> rax = entry, or 0 with ZF set

;; ----- resolve @ 0x187 -----

89 FE                                     ; 0x187  mov esi, edi
E8 B3 FF FF FF                            ; 0x189  call canon  (rel32 = 0x141 - 0x18E; canon = 0x100141)
8B 55 90                                  ; 0x18E  mov edx, [rbp + G_END]  (G_END = -0x70)
;;   .l @ 0x191
83 EA 18                                  ; 0x191  sub edx, 24
81 FA 00 40 00 50                         ; 0x194  cmp edx, ENTS  (ENTS = 0x50004000)
72 1D                                     ; 0x19A  jb .no  (rel8 = 0x1B9 - 0x19C)
80 7A 14 00                               ; 0x19C  cmp byte [rdx + E_TYPE], 0  (E_TYPE = 0x14)
74 EF                                     ; 0x1A0  je .l  (rel8 = 0x191 - 0x1A2)
8B 4D A8                                  ; 0x1A2  mov ecx, [rbp + G_PBLEN]  (G_PBLEN = -0x58)
3B 4A 04                                  ; 0x1A5  cmp ecx, [rdx + E_NLEN]  (E_NLEN = 0x4)
75 E7                                     ; 0x1A8  jne .l  (rel8 = 0x191 - 0x1AA)
8B 32                                     ; 0x1AA  mov esi, [rdx + E_NAME]  (E_NAME = 0x0)
BF 00 00 00 30                            ; 0x1AC  mov edi, PB  (PB = 0x30000000)
F3 A6                                     ; 0x1B1  repe cmpsb
75 DC                                     ; 0x1B3  jne .l  (rel8 = 0x191 - 0x1B5)
92                                        ; 0x1B5  xchg eax, edx
85 C0                                     ; 0x1B6  test eax, eax
C3                                        ; 0x1B8  ret
;;   .no @ 0x1B9
31 C0                                     ; 0x1B9  xor eax, eax
C3                                        ; 0x1BB  ret

;; bl = type -> rax = new entry named PB

;; ----- newent @ 0x1BC -----

8B 45 90                                  ; 0x1BC  mov eax, [rbp + G_END]  (G_END = -0x70)
83 45 90 18                               ; 0x1BF  add dword [rbp + G_END], 24  (G_END = -0x70)
88 58 14                                  ; 0x1C3  mov [rax + E_TYPE], bl  (E_TYPE = 0x14)
;; rax = entry; its name becomes a copy of PB

;; ----- setname @ 0x1C6 -----

8B 7D 98                                  ; 0x1C6  mov edi, [rbp + G_HEAP]  (G_HEAP = -0x68)
89 38                                     ; 0x1C9  mov [rax + E_NAME], edi  (E_NAME = 0x0)
8B 4D A8                                  ; 0x1CB  mov ecx, [rbp + G_PBLEN]  (G_PBLEN = -0x58)
89 48 04                                  ; 0x1CE  mov [rax + E_NLEN], ecx  (E_NLEN = 0x4)
BE 00 00 00 30                            ; 0x1D1  mov esi, PB  (PB = 0x30000000)
F3 A4                                     ; 0x1D6  rep movsb
89 7D 98                                  ; 0x1D8  mov [rbp + G_HEAP], edi  (G_HEAP = -0x68)
C3                                        ; 0x1DB  ret

;; rdi = fd -> rbx = slot, rax = entry; CF if closed

;; ----- fdp @ 0x1DC -----

8D 5C FD 58                               ; 0x1DC  lea ebx, [rbp + P_FDS + rdi*8]  (P_FDS = 0x58)
8B 03                                     ; 0x1E0  mov eax, [rbx]
83 F8 01                                  ; 0x1E2  cmp eax, 1
C3                                        ; 0x1E5  ret

;; ---- files ---------------------------------------------------------------

;; ----- sys_open @ 0x1E6 -----
;; rdi path, rsi flags
56                                        ; 0x1E6  push rsi
E8 9B FF FF FF                            ; 0x1E7  call resolve  (rel32 = 0x187 - 0x1EC; resolve = 0x100187)
5E                                        ; 0x1EC  pop rsi
75 13                                     ; 0x1ED  jnz .have  (rel8 = 0x202 - 0x1EF)
0F BA E6 06                               ; 0x1EF  bt esi, 6  ; O_CREAT
0F 83 9A 01 00 00                         ; 0x1F3  jnc enoent  (rel32 = 0x393 - 0x1F9; enoent = 0x100393)
B3 01                                     ; 0x1F9  mov bl, 1
E8 BC FF FF FF                            ; 0x1FB  call newent  (rel32 = 0x1BC - 0x200; newent = 0x1001BC)
EB 18                                     ; 0x200  jmp .fd  (rel8 = 0x21A - 0x202)
;;   .have @ 0x202
0F BA E6 07                               ; 0x202  bt esi, 7  ; O_EXCL
0F 82 8F 01 00 00                         ; 0x206  jc eexist  (rel32 = 0x39B - 0x20C; eexist = 0x10039B)
0F BA E6 09                               ; 0x20C  bt esi, 9  ; O_TRUNC: past size stays zero
73 08                                     ; 0x210  jnc .fd  (rel8 = 0x21A - 0x212)
83 60 0C 00                               ; 0x212  and dword [rax + E_SIZE], 0  (E_SIZE = 0xC)
83 60 10 00                               ; 0x216  and dword [rax + E_CAP], 0  (E_CAP = 0x10)
;;   .fd @ 0x21A
8D 5D 50                                  ; 0x21A  lea ebx, [rbp + P_FDS - 8]  (P_FDS = 0x58)
;;   .f @ 0x21D
83 C3 08                                  ; 0x21D  add ebx, 8
83 3B 00                                  ; 0x220  cmp dword [rbx], 0
75 F8                                     ; 0x223  jne .f  (rel8 = 0x21D - 0x225)
89 03                                     ; 0x225  mov [rbx], eax
83 63 04 00                               ; 0x227  and dword [rbx + 4], 0
8D 43 A8                                  ; 0x22B  lea eax, [rbx - P_FDS]  (P_FDS = 0x58)
29 E8                                     ; 0x22E  sub eax, ebp
C1 E8 03                                  ; 0x230  shr eax, 3
C3                                        ; 0x233  ret

;; ----- sys_close @ 0x234 -----

E8 A3 FF FF FF                            ; 0x234  call fdp  (rel32 = 0x1DC - 0x239; fdp = 0x1001DC)
0F 82 58 01 00 00                         ; 0x239  jc ebadf  (rel32 = 0x397 - 0x23F; ebadf = 0x100397)
83 23 00                                  ; 0x23F  and dword [rbx], 0
E9 49 01 00 00                            ; 0x242  jmp ok  (rel32 = 0x390 - 0x247; ok = 0x100390)

