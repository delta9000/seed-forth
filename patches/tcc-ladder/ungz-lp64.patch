# Purpose: compile pinned bintools with standard LP64 TinyCC rather than pnut.
# Original: vendor/pnut/kit/bintools/ungz.c, pinned by tcc-bintools-inputs.sha256.
# LP64 uses 32-bit int and 64-bit unsigned long. A trailer byte << 24 can
# overflow signed int before conversion, producing sign extension and a
# false CRC32 mismatch. Cast to unsigned long before shifting.
# The seed-derived simple-patch applies the exact before/after fixtures;
# bintools.manifest independently pins original and patched source bytes.
--- a/bintools-src/ungz.c
+++ b/bintools-src/ungz.c
@@ -162,11 +162,11 @@
       ASSERT(src_len + 8 <= compressed_size, "Input file is missing CRC32 and ISIZE");
 
       // CRC32 is at the end of the compressed data
-      unsigned long crc32 =  gz_source[src_len + 0]        | (gz_source[src_len + 1] << 8)
-                          | (gz_source[src_len + 2] << 16) | (gz_source[src_len + 3] << 24);
+      unsigned long crc32 =  ((unsigned long) gz_source[src_len + 0])        | (((unsigned long) gz_source[src_len + 1]) << 8)
+                          | (((unsigned long) gz_source[src_len + 2]) << 16) | (((unsigned long) gz_source[src_len + 3]) << 24);
 
-      unsigned long isize =  gz_source[src_len + 4]        | (gz_source[src_len + 5] << 8)
-                          | (gz_source[src_len + 6] << 16) | (gz_source[src_len + 7] << 24);
+      unsigned long isize =  ((unsigned long) gz_source[src_len + 4])        | (((unsigned long) gz_source[src_len + 5]) << 8)
+                          | (((unsigned long) gz_source[src_len + 6]) << 16) | (((unsigned long) gz_source[src_len + 7]) << 24);
 
       // Check CRC32 and ISIZE
       unsigned long computed_crc = crc(gz_dest, dest_len);
