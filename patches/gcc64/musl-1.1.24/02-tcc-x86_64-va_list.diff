# Provenance: ours (seed-forth gcc64), not in live-bootstrap.
# musl-1.1.24 for tcc-0.9.27 on x86_64: va_list.
# tcc has no __builtin_va_list on x86_64 SysV; define it as tcc's own
# register-save-area struct (tcc include/stdarg.h) and map __builtin_va_*
# onto tcc's __va_start/__va_arg (tcc lib/va_list.c, in libtcc1.a).
# The x86_64 analogue of live-bootstrap's i386 va_list.patch.
--- a/arch/x86_64/bits/alltypes.h.in
+++ b/arch/x86_64/bits/alltypes.h.in
@@ -2,6 +2,29 @@
 #define _Int64 long
 #define _Reg long
 
+#if defined(__TINYC__) && !defined(__TINYC_va_list_defs)
+/* tcc 0.9.27 on x86_64 has no __builtin_va_list; use its own SysV va_list
+   (tcc's include/stdarg.h), whose helpers are in libtcc1.a (lib/va_list.c). */
+#define __TINYC_va_list_defs
+typedef struct {
+	unsigned int gp_offset;
+	unsigned int fp_offset;
+	union {
+		unsigned int overflow_offset;
+		char *overflow_arg_area;
+	};
+	char *reg_save_area;
+} __va_list_struct;
+typedef __va_list_struct __builtin_va_list[1];
+void __va_start(__va_list_struct *, void *);
+void *__va_arg(__va_list_struct *, int, int, int);
+#define __builtin_va_start(ap, last) __va_start(ap, __builtin_frame_address(0))
+#define __builtin_va_arg(ap, type) \
+	(*(type *)(__va_arg(ap, __builtin_va_arg_types(type), sizeof(type), __alignof__(type))))
+#define __builtin_va_copy(dest, src) (*(dest) = *(src))
+#define __builtin_va_end(ap)
+#endif
+
 TYPEDEF __builtin_va_list va_list;
 TYPEDEF __builtin_va_list __isoc_va_list;
 
