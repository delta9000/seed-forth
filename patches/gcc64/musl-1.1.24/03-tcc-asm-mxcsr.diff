# Provenance: ours (seed-forth gcc64), not in live-bootstrap.
# musl-1.1.24 for tcc-0.9.27 on x86_64: tcc's assembler lacks stmxcsr/ldmxcsr.
# live-bootstrap (i386) deletes them; on x86_64 SSE is the FPU, so keep them,
# hand-encoded as .byte (0F AE /3 and /2).  Verified with objdump.
--- a/src/fenv/x86_64/fenv.s
+++ b/src/fenv/x86_64/fenv.s
@@ -8,14 +8,14 @@
 	test %eax,%ecx
 	jz 1f
 	fnclex
-1:	stmxcsr -8(%rsp)
+1:	.byte 0x0f,0xae,0x5c,0x24,0xf8	# stmxcsr -8(%rsp) (tcc 0.9.27 has no SSE control insns)
 	and $0x3f,%eax
 	or %eax,-8(%rsp)
 	test %ecx,-8(%rsp)
 	jz 1f
 	not %ecx
 	and %ecx,-8(%rsp)
-	ldmxcsr -8(%rsp)
+	.byte 0x0f,0xae,0x54,0x24,0xf8	# ldmxcsr -8(%rsp) (tcc 0.9.27 has no SSE control insns)
 1:	xor %eax,%eax
 	ret
 
@@ -23,9 +23,9 @@
 .type feraiseexcept,@function
 feraiseexcept:
 	and $0x3f,%edi
-	stmxcsr -8(%rsp)
+	.byte 0x0f,0xae,0x5c,0x24,0xf8	# stmxcsr -8(%rsp) (tcc 0.9.27 has no SSE control insns)
 	or %edi,-8(%rsp)
-	ldmxcsr -8(%rsp)
+	.byte 0x0f,0xae,0x54,0x24,0xf8	# ldmxcsr -8(%rsp) (tcc 0.9.27 has no SSE control insns)
 	xor %eax,%eax
 	ret
 
@@ -40,11 +40,11 @@
 	andb $0xf3,1(%rsp)
 	or %ch,1(%rsp)
 	fldcw (%rsp)
-	stmxcsr (%rsp)
+	.byte 0x0f,0xae,0x1c,0x24	# stmxcsr (%rsp) (tcc 0.9.27 has no SSE control insns)
 	shl $3,%ch
 	andb $0x9f,1(%rsp)
 	or %ch,1(%rsp)
-	ldmxcsr (%rsp)
+	.byte 0x0f,0xae,0x14,0x24	# ldmxcsr (%rsp) (tcc 0.9.27 has no SSE control insns)
 	pop %rcx
 	ret
 
@@ -52,7 +52,7 @@
 .type fegetround,@function
 fegetround:
 	push %rax
-	stmxcsr (%rsp)
+	.byte 0x0f,0xae,0x1c,0x24	# stmxcsr (%rsp) (tcc 0.9.27 has no SSE control insns)
 	pop %rax
 	shr $3,%eax
 	and $0xc00,%eax
@@ -63,7 +63,7 @@
 fegetenv:
 	xor %eax,%eax
 	fnstenv (%rdi)
-	stmxcsr 28(%rdi)
+	.byte 0x0f,0xae,0x5f,0x1c	# stmxcsr 28(%rdi) (tcc 0.9.27 has no SSE control insns)
 	ret
 
 .global fesetenv
@@ -73,7 +73,7 @@
 	inc %rdi
 	jz 1f
 	fldenv -1(%rdi)
-	ldmxcsr 27(%rdi)
+	.byte 0x0f,0xae,0x57,0x1b	# ldmxcsr 27(%rdi) (tcc 0.9.27 has no SSE control insns)
 	ret
 1:	push %rax
 	push %rax
@@ -81,7 +81,7 @@
 	pushq $0x37f
 	fldenv (%rsp)
 	pushq $0x1f80
-	ldmxcsr (%rsp)
+	.byte 0x0f,0xae,0x14,0x24	# ldmxcsr (%rsp) (tcc 0.9.27 has no SSE control insns)
 	add $40,%rsp
 	ret
 
@@ -90,7 +90,7 @@
 fetestexcept:
 	and $0x3f,%edi
 	push %rax
-	stmxcsr (%rsp)
+	.byte 0x0f,0xae,0x1c,0x24	# stmxcsr (%rsp) (tcc 0.9.27 has no SSE control insns)
 	pop %rsi
 	fnstsw %ax
 	or %esi,%eax
