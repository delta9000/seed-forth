# tcc-0.9.27: no enum declared inside a function, under PNUT_CC.
#
# Applies to: tcc-0.9.27/x86_64-gen.c (classify_x86_64_va_arg).
#
# Why: pnut does not accept an `enum` declared at block scope; tcc-pnut
# stops with "codegen_rvalue: unexpected operator" (op 323 = ENUM_KW).
# Under PNUT_CC (set only when pnut compiles tcc) the three enumerators
# become #defines with the same values; every other compiler, including
# the tcc-boot* stages, still sees the original enum.
--- a/x86_64-gen.c
+++ b/x86_64-gen.c
@@ -1195,9 +1195,15 @@
 ST_FUNC int classify_x86_64_va_arg(CType *ty)
 {
     /* This definition must be synced with stdarg.h */
+#ifdef PNUT_CC
+#define __va_gen_reg 0
+#define __va_float_reg 1
+#define __va_stack 2
+#else
     enum __va_arg_type {
         __va_gen_reg, __va_float_reg, __va_stack
     };
+#endif
     int size, align, reg_count;
     X86_64_Mode mode = classify_x86_64_arg(ty, NULL, &size, &align, &reg_count);
     switch (mode) {
