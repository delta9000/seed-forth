#define SIZEOF_NUM_BUF 100
char _num_buf[SIZEOF_NUM_BUF];

// u is the magnitude, neg says whether a '-' goes in front.
char *_int_to_str(unsigned long long u, int neg, int base, int width, int force_0, int force_plus, int left_justify) {

  char *out = _num_buf + SIZEOF_NUM_BUF;
  int has_sign = neg || force_plus;
  char *digits = "0123456789abcdef";

  *--out = 0;

  do {
    *--out = digits[u % base];
    u /= base;
  } while (u != 0);

  if (width >= SIZEOF_NUM_BUF) width = SIZEOF_NUM_BUF-1;

