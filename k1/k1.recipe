# K1's init, run by the K0-built runner as  /k0/build-out/amd64-runner --recipe /k1.recipe
# Everything below starts from the input disk's tree, whose only executable is
# hex0-seed: the same steps tools/chain-root.sh runs, with K1 as the kernel.
run 0 - /dev/console /dev/console /hex0-seed /000-seed.hex0 /seed-forth
chmod /seed-forth
say "k1: seed-forth built by hex0-seed"
run 0 /tools/tcc-ladder-start.fth /dev/console /dev/console /seed-forth
run 0 - /dev/console /dev/console /build-out/amd64-runner --recipe /tools/ladder.recipe
run 0 - /dev/console /dev/console /build-out/pnut-amd64/usr/bin/bash /ladder/stage10.sh
run 0 - /dev/console /dev/console /usr/bin/bash /ladder/stage11.sh
run 0 - /dev/console /dev/console /usr/bin/bash /ladder/stage12.sh
run 0 - /dev/console /dev/console /usr/bin/bash /ladder/finish.sh
