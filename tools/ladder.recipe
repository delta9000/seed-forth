# The ladder past TinyCC: run after tools/amd64.recipe, from the repository
# root, as  build-out/amd64-runner --recipe tools/ladder.recipe
# Each stage is explicit runner commands: no shell, make, sed or patch.
set W ${ROOT}/build-out/pnut-amd64
set K ${W}/kit
set TESTS ${ROOT}/tests/pnut/amd64
cd ${K}
# ---- stage 8: musl-1.1.24 and tcc to a fixed point (gcc64 stages 1-2) ----
# gcc64/run-gcc64.sh runs configure and make; here every command is explicit
# (tools/musl.recipe, tools/mktcc.recipe) and patches are exact fixtures.
set G ${W}/gcc64
set D ${ROOT}/build-out/distfiles
mkdir ${G}
mkdir ${G}/tools
mkdir ${G}/logs
run 0 - ${G}/logs/tools.out ${G}/logs/tools.err build/tcc-boot2 -static -I libc64/include ${ROOT}/tools/musl-gen.c -o ${G}/tools/musl-gen
run 0 - ${G}/logs/tools.out ${G}/logs/tools.err build/tcc-boot2 -static -I libc64/include ${ROOT}/tools/runargs.c -o ${G}/tools/runargs
copy ${ROOT}/tools/musl-libc-objs.txt ${G}/tools/musl-libc-objs.txt
patches ${ROOT}/patches/gcc64/exact/tcc.manifest ${ROOT}/patches/gcc64/exact
patches ${ROOT}/patches/gcc64/exact/bridge.manifest ${ROOT}/patches/gcc64/exact
mkdir ${G}/p0
mkdir ${G}/p0/bin
mkdir ${G}/p0/lib
mkdir ${G}/p0/lib/tcc
copy build/boot2-lib/crt1.o ${G}/p0/lib/crt1.o
copy build/boot2-lib/crti.o ${G}/p0/lib/crti.o
copy build/boot2-lib/crtn.o ${G}/p0/lib/crtn.o
copy build/boot2-lib/tcc/libtcc1.a ${G}/p0/lib/tcc/libtcc1.a
run 0 - ${G}/logs/p0.out ${G}/logs/p0.err build/tcc-boot2 -c -D ADD_LIBC_STUB -I libc64/include -o ${G}/p0/lib/libc.o libc64/libc.c
run 0 - ${G}/logs/p0.out ${G}/logs/p0.err build/tcc-boot2 -ar cr ${G}/p0/lib/libc.a ${G}/p0/lib/libc.o
unlink ${G}/p0/lib/libc.o
run 0 - ${G}/logs/p0.out ${G}/logs/p0.err build/tcc-boot2 -static -o ${G}/p0/bin/tcc -D BOOTSTRAP=1 -D __SIZEOF_LONG_LONG__=8 -D HAVE_FLOAT=1 -D HAVE_BITFIELD=1 -D HAVE_LONG_LONG=1 -D HAVE_SETJMP=1 -I libc64/include -D TCC_TARGET_X86_64=1 -D "CONFIG_TCCDIR=\"${G}/p0/lib/tcc\"" -D "CONFIG_TCC_CRTPREFIX=\"${G}/p0/lib\"" -D "CONFIG_TCC_LIBPATHS=\"${G}/p0/lib:${G}/p0/lib/tcc\"" -D "CONFIG_TCC_SYSINCLUDEPATHS=\"${G}/p0/include\"" -D "TCC_LIBGCC=\"${G}/p0/lib/libc.a\"" -D 'TCC_LIBTCC1="libtcc1.a"' -D 'CONFIG_TCC_ELFINTERP="/mes/loader"' -D CONFIG_TCCBOOT=1 -D CONFIG_TCC_STATIC=1 -D CONFIG_USE_LIBGCC=1 -D 'TCC_VERSION="0.9.27"' -D ONE_SOURCE=1 -L ${G}/p0/lib tcc-0.9.27/tcc.c
pin ${D}/musl-1.1.24.tar.gz 1370c9a812b2cf2a7d92802510cca0058cc37e66a7bedd70051f0a34015022a3
run 0 - ${G}/logs/ungz.out ${G}/logs/ungz.err ./bintools ungz --file ${D}/musl-1.1.24.tar.gz --output ${G}/musl.tar
mkdir ${G}/musl-1
cd ${G}/musl-1
run 0 - ${G}/logs/untar.out ${G}/logs/untar.err ${K}/bintools untar ${G}/musl.tar
cd ${G}/musl-1/musl-1.1.24
copy ${K}/simple-patch simple-patch
chmod simple-patch
patches ${ROOT}/patches/gcc64/exact/musl.manifest ${ROOT}/patches/gcc64/exact
text ${G}/musl-1.head "set CC ${G}/p0/bin/tcc\nset P ${G}/t1\nset T ${G}/tools\nset L ${G}/logs\n"
cat ${G}/musl-1.recipe ${G}/musl-1.head ${ROOT}/tools/musl.recipe
run 0 - ${G}/logs/musl-1.out ${G}/logs/musl-1.err ${ROOT}/build-out/amd64-runner --recipe ${G}/musl-1.recipe
text ${G}/tcc-1.head "set CC ${G}/p0/bin/tcc\nset ML ${G}/t1\nset P ${G}/t1\nset S ${K}/tcc-0.9.27\nset L ${G}/logs\n"
cat ${G}/tcc-1.recipe ${G}/tcc-1.head ${ROOT}/tools/mktcc.recipe
run 0 - ${G}/logs/tcc-1.out ${G}/logs/tcc-1.err ${ROOT}/build-out/amd64-runner --recipe ${G}/tcc-1.recipe
cd ${K}
artifact ${G}/t1/lib/libc.a 4cccfbd5e2eb803abcbbd6b4bc118e9028127220cdc6d78f6b91b39a6afe8ac6
mkdir ${G}/musl-2
cd ${G}/musl-2
run 0 - ${G}/logs/untar.out ${G}/logs/untar.err ${K}/bintools untar ${G}/musl.tar
cd ${G}/musl-2/musl-1.1.24
copy ${K}/simple-patch simple-patch
chmod simple-patch
patches ${ROOT}/patches/gcc64/exact/musl.manifest ${ROOT}/patches/gcc64/exact
text ${G}/musl-2.head "set CC ${G}/t1/bin/tcc\nset P ${G}/tc\nset T ${G}/tools\nset L ${G}/logs\n"
cat ${G}/musl-2.recipe ${G}/musl-2.head ${ROOT}/tools/musl.recipe
run 0 - ${G}/logs/musl-2.out ${G}/logs/musl-2.err ${ROOT}/build-out/amd64-runner --recipe ${G}/musl-2.recipe
text ${G}/tcc-2.head "set CC ${G}/t1/bin/tcc\nset ML ${G}/tc\nset P ${G}/tc\nset S ${K}/tcc-0.9.27\nset L ${G}/logs\n"
cat ${G}/tcc-2.recipe ${G}/tcc-2.head ${ROOT}/tools/mktcc.recipe
run 0 - ${G}/logs/tcc-2.out ${G}/logs/tcc-2.err ${ROOT}/build-out/amd64-runner --recipe ${G}/tcc-2.recipe
cd ${K}
artifact ${G}/tc/lib/libc.a 57d4b5e9f78026c4ea9f05ed32b3cc27f955c9f56e167727c69aa4343e5c74ac
copy ${G}/tc/lib/libc.a ${G}/libc-2.a
copy ${G}/tc/bin/tcc ${G}/tcc-2
chmod ${G}/tcc-2
mkdir ${G}/musl-3
cd ${G}/musl-3
run 0 - ${G}/logs/untar.out ${G}/logs/untar.err ${K}/bintools untar ${G}/musl.tar
cd ${G}/musl-3/musl-1.1.24
copy ${K}/simple-patch simple-patch
chmod simple-patch
patches ${ROOT}/patches/gcc64/exact/musl.manifest ${ROOT}/patches/gcc64/exact
text ${G}/musl-3.head "set CC ${G}/tcc-2\nset P ${G}/tc\nset T ${G}/tools\nset L ${G}/logs\n"
cat ${G}/musl-3.recipe ${G}/musl-3.head ${ROOT}/tools/musl.recipe
run 0 - ${G}/logs/musl-3.out ${G}/logs/musl-3.err ${ROOT}/build-out/amd64-runner --recipe ${G}/musl-3.recipe
text ${G}/tcc-3.head "set CC ${G}/tcc-2\nset ML ${G}/tc\nset P ${G}/tc\nset S ${K}/tcc-0.9.27\nset L ${G}/logs\n"
cat ${G}/tcc-3.recipe ${G}/tcc-3.head ${ROOT}/tools/mktcc.recipe
run 0 - ${G}/logs/tcc-3.out ${G}/logs/tcc-3.err ${ROOT}/build-out/amd64-runner --recipe ${G}/tcc-3.recipe
cd ${K}
same ${G}/libc-2.a ${G}/tc/lib/libc.a
same ${G}/tcc-2 ${G}/tc/bin/tcc
run 0 - ${G}/logs/printf.out ${G}/logs/printf.err ${G}/tc/bin/tcc ${TESTS}/printf.c -o ${G}/printf-musl
run 0 - ${G}/printf-musl.stdout ${G}/printf-musl.err ${G}/printf-musl
same ${TESTS}/printf.out ${G}/printf-musl.stdout
say "amd64: stage 8: musl-1.1.24 and tcc-musl at a fixed point (gcc64's pinned libc.a)"
# ---- stage 9: the first tools, each replayed from a host capture ----
# ladder/NAME/recipe was written by tools/capture-build.py; its fixtures are
# the files the host's configure and shell wrote that the build reads.
set TC ${G}/tc/bin/tcc
set U ${W}/usr
mkdir ${U}
mkdir ${U}/bin
mkdir ${W}/src
# make-3.82
pin ${D}/make-3.82.tar.gz 3d991b33e604187c5881a0abc2e102d5b9776da5569640e73778f85d617242e7
mkdir ${W}/src/make-3.82
cd ${W}/src/make-3.82
run 0 - ${W}/src/make-3.82.out ${W}/src/make-3.82.err ${K}/bintools ungz --file ${D}/make-3.82.tar.gz --output ${W}/src/make-3.82.tar
run 0 - ${W}/src/make-3.82.out ${W}/src/make-3.82.err ${K}/bintools untar ${W}/src/make-3.82.tar
unlink ${W}/src/make-3.82.tar
cd ${W}/src/make-3.82/make-3.82
text ${W}/src/make-3.82.head "set CC ${TC}\nset T ${G}/tools\nset P ${U}\nset L ${W}/src\nset SRC ${ROOT}/ladder/make-3.82\nset B ${W}/src/make-3.82/make-3.82\n"
cat ${W}/src/make-3.82.recipe ${W}/src/make-3.82.head ${ROOT}/ladder/make-3.82/recipe
run 0 - ${W}/src/make-3.82.log ${W}/src/make-3.82.err ${ROOT}/build-out/amd64-runner --recipe ${W}/src/make-3.82.recipe
chmod ${U}/bin/make
artifact ${U}/bin/make f8b0662b41cfa7721b0b4df769949bb7f69909fdf70e46d520f91a5aec2389ea
say "ladder: make-3.82"
# gzip-1.13
