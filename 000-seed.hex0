48 8B 7D 00                               ; mov rdi, [rbp]
48 83 C5 08                               ; add rbp, 8         ; drop the flag: ( n )
48 8B 04 25 00 30 41 00                   ; mov rax, [STATE]
48 85 C0                                  ; test rax, rax
75 01                                     ; jnz .compile  (rel8 = 0x5EA - 0x5E9)
C3                                        ; ret                ; interpret: n stays on the stack
