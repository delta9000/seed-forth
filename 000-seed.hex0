48 29 C7                                  ; sub rdi, rax       ; rel32 = xt - (HERE + 5)
89 78 FC                                  ; mov [rax-4], edi
48 89 04 25 10 30 41 00                   ; mov [HERE], rax    ; HERE += 5
48 8B 7D 00                               ; mov rdi, [rbp]
48 83 C5 08                               ; add rbp, 8
C3                                        ; ret

