human.c: compute in double instead of long double (seed-cc compiler gap)

Origin: written for seed-forth's plumbing stage 2; not an upstream change.
Why: lib/human.c (coreutils 5.0) does its floating fallback in long double,
  and the Forth C compiler cannot yet compute with long double (error 249,
  "long-double", documented in book/A7-error-codes.md).  human.o is needed
  by ls, du, sum and shred.  The fallback only runs when an exact integer
  computation would overflow (block-size conversions of huge counts), and
  the upstream comment already says it may be "slightly off"; double keeps
  53 bits instead of 64 there.  Integer paths are unchanged.
Remove: when the compiler computes with long double.
Applied by: plumbing/stage2.kaem, with the patch 2.5.9 built just before
  coreutils (patch -p1 -i in the coreutils-5.0 tree).

--- coreutils-5.0/lib/human.c
+++ coreutils-5.0/lib/human.c
@@ -101,8 +101,8 @@
 /* If INEXACT_STYLE is not human_round_to_nearest, and if easily
    possible, adjust VALUE according to the style.  */
 
-static long double
-adjust_value (int inexact_style, long double value)
+static double
+adjust_value (int inexact_style, double value)
 {
   /* Do not use the floorl or ceill functions, as that would mean
      checking for their presence and possibly linking with the
@@ -273,20 +273,20 @@
        or from_block_size is zero.  Fall back on floating point.
        FIXME: This can yield answers that are slightly off.  */
 
-    long double dto_block_size = to_block_size;
-    long double damt = n * (from_block_size / dto_block_size);
+    double dto_block_size = to_block_size;
+    double damt = n * (from_block_size / dto_block_size);
     size_t buflen;
     size_t nonintegerlen;
 
     if (! (opts & human_autoscale))
       {
-	sprintf (buf, "%.0Lf", adjust_value (inexact_style, damt));
+	sprintf (buf, "%.0f", adjust_value (inexact_style, damt));
 	buflen = strlen (buf);
 	nonintegerlen = 0;
       }
     else
       {
-	long double e = 1;
+	double e = 1;
 	exponent = 0;
 
 	do
@@ -298,7 +298,7 @@
 
 	damt /= e;
 
-	sprintf (buf, "%.1Lf", adjust_value (inexact_style, damt));
+	sprintf (buf, "%.1f", adjust_value (inexact_style, damt));
 	buflen = strlen (buf);
 	nonintegerlen = decimal_pointlen + 1;
 
@@ -306,7 +306,7 @@
 	    || ((opts & human_suppress_point_zero)
 		&& buf[buflen - 1] == '0'))
 	  {
-	    sprintf (buf, "%.0Lf",
+	    sprintf (buf, "%.0f",
 		     adjust_value (inexact_style, damt * 10) / 10);
 	    buflen = strlen (buf);
 	    nonintegerlen = 0;
